{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["iconutil", "cl", "lipo", "ffmpeg", "ffprobe"],
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "src/renderer/src/routes/**/*.{ts,tsx}",
        "scripts/*.{mjs,cjs,ts}",
        "scripts/sandbox-import-scope/{index,preload}.cjs",
        "src/main/core/media-warm/service.ts",
        "src/main/core/enrichment-sidecar.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,cjs,ts}"],
      "ignoreDependencies": [
        "@types/better-sqlite3",
        "app-builder-lib",
        "drizzle-kit"
      ]
    },
    "apps/website": {
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["@pond/theme"]
    },
    "apps/extension": {
      "entry": ["entrypoints/**/*.{ts,tsx}", "scripts/*.mjs"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/raycast": {
      "entry": [
        "src/*.{ts,tsx}",
        "src/tools/*.ts",
        "scripts/*.mjs",
        "tests/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.mjs", "tests/**/*.ts"]
    },
    "packages/video": {
      "entry": [
        "src/index.ts",
        "cli/*.{mjs,cjs}",
        "stage/main.tsx",
        "videos/*/index.tsx"
      ],
      "project": ["**/*.{ts,tsx,mjs,cjs}"],
      "ignoreDependencies": ["@pond/theme"]
    },
    "packages/schema": {
      "entry": ["scripts/*.ts"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/api": {
      "project": ["src/**/*.ts"]
    },
    ".": {
      "entry": ["scripts/*.{mjs,cjs,ts}", "tools/**/*.{ts,mjs}"]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
