{
  "name": "@pond/repo",
  "private": true,
  "type": "module",
  "version": "2.8.3",
  "description": "A local-first archive for everything you save across Twitter/X, Instagram, Pinterest, Are.na, Cosmos, TikTok, YouTube, and any web article.",
  "license": "MIT",
  "author": {
    "name": "Raphael Salaja",
    "url": "https://github.com/raphaelsalaja"
  },
  "homepage": "https://github.com/raphaelsalaja/pond#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/pond/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/pond.git"
  },
  "packageManager": "pnpm@11.27.0",
  "scripts": {
    "build": "turbo run build perf:check:repo",
    "dev": "node scripts/run-dev-singleton.mjs -- pnpm exec turbo run dev",
    "dev:desktop": "node scripts/run-dev-singleton.mjs -- pnpm --filter @pond/desktop dev",
    "cli": "pnpm --filter @pond/cli exec tsx src/index.ts",
    "cli:build": "pnpm --filter @pond/cli build",
    "cli:link": "pnpm --filter @pond/cli build && pnpm --filter @pond/cli link --global",
    "video": "pnpm --filter @pond/video video",
    "generate": "turbo run generate",
    "generate:check": "turbo run generate:check",
    "lint": "turbo run lint:repo",
    "lint:repo": "oxlint --deny-warnings && stylelint \"**/*.css\" --ignore-path .gitignore --max-warnings 0 && oxfmt --check",
    "knip": "turbo run knip:repo",
    "knip:repo": "pnpm --filter @pond/desktop exec tsr generate && knip",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "perf:check": "turbo run perf:check:repo",
    "perf:check:repo": "node scripts/check-performance-budgets.mjs",
    "sbom:generate": "pnpm sbom --sbom-format spdx --prod --out pond.spdx.json",
    "dist": "turbo run dist",
    "dist:mac": "turbo run build --filter @pond/desktop && pnpm --filter @pond/desktop dist:mac",
    "dist:win": "turbo run build --filter @pond/desktop && pnpm --filter @pond/desktop dist:win",
    "dist:win:publish": "turbo run build --filter @pond/desktop && pnpm --filter @pond/desktop dist:win:publish",
    "dist:linux": "turbo run build --filter @pond/desktop && pnpm --filter @pond/desktop dist:linux",
    "dist:linux:publish": "turbo run build --filter @pond/desktop && pnpm --filter @pond/desktop dist:linux:publish",
    "prepare": "husky",
    "lint:fix": "oxlint --fix && stylelint \"**/*.css\" --ignore-path .gitignore --fix && oxfmt",
    "format": "oxfmt",
    "check": "node --test scripts/run-dev-singleton.test.mjs && turbo run lint:repo architecture:check:repo knip:repo generate:check typecheck test",
    "architecture:check": "turbo run architecture:check:repo",
    "architecture:check:repo": "node --test scripts/check-architecture.test.mjs && node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.2.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@interfere/landmines": "0.2.1",
    "@oxlint/plugins": "1.94.0",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "oxc-parser": "0.154.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.9.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-order": "8.1.3",
    "tsrs": "7.1.0-beta.tsrs4",
    "turbo": "^2.11.8",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}
