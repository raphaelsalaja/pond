{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["iconutil", "cl", "lipo", "mkfifo"],
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "src/renderer/src/routes/**/*.{ts,tsx}",
        "scripts/*.{mjs,cjs,ts}",
        "scripts/sandbox-import-scope/{index,preload}.cjs",
        "scripts/proof-scenarios/*.cjs",
        "scripts/journeys/*.cjs",
        "src/main/core/media-warm/service.ts",
        "src/main/core/enrichment-sidecar.ts",
        "src/main/core/duplicates/fingerprint-worker.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{mjs,cjs,ts}"],
      "ignoreDependencies": [
        "@types/better-sqlite3",
        "app-builder-lib",
        "drizzle-kit",
        "ffprobe-static"
      ]
    },
    "apps/website": {
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["@pond/theme"]
    },
    "apps/extension": {
      "entry": ["entrypoints/**/*.{ts,tsx}", "scripts/*.mjs"],
      "project": ["**/*.{ts,tsx}"]
    },
    "apps/raycast": {
      "entry": [
        "src/*.{ts,tsx}",
        "src/tools/*.ts",
        "scripts/*.mjs",
        "tests/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.mjs", "tests/**/*.ts"]
    },
    "packages/share-page": {
      "entry": ["src/main.tsx"],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["@pond/theme"]
    },
    "packages/icons": {
      "entry": ["src/**/*.mjs", "scripts/*.mjs"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/api": {
      "project": ["src/**/*.ts"]
    },
    ".": {
      "entry": ["scripts/*.{mjs,cjs,ts}", "tools/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
