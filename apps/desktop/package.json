{
  "name": "@pond/desktop",
  "productName": "Pond",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pond desktop app: local-first archive with a menu-bar tray, local SQLite index and filesystem library.",
  "license": "MIT",
  "author": {
    "name": "Raphael Salaja",
    "url": "https://github.com/raphaelsalaja"
  },
  "homepage": "https://github.com/raphaelsalaja/pond#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/pond/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/pond.git",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "postinstall": "node ./scripts/ensure-electron.mjs || true && node ./scripts/rebuild-native.mjs || true && node ./scripts/generate-dev-icon.mjs || true && node ./scripts/patch-electron-name.mjs || true && node ./scripts/copy-replay-assets.mjs || true",
    "rebuild": "node ./scripts/rebuild-native.mjs",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac --arm64 --x64",
    "dist:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "db:generate": "ELECTRON_RUN_AS_NODE=1 pnpm exec electron ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "ELECTRON_RUN_AS_NODE=1 pnpm exec electron ./node_modules/drizzle-kit/bin.cjs push",
    "typecheck": "tsr generate && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:live": "POND_LIVE=1 vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.1",
    "@ai-sdk/google": "^4.0.2",
    "@ai-sdk/openai": "^4.0.2",
    "@ai-sdk/openai-compatible": "^3.0.1",
    "@base-ui/react": "^1.6.0",
    "@blossom-carousel/react": "^1.3.0",
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@hono/node-server": "^2.0.2",
    "@huggingface/transformers": "^4.2.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@lexical/react": "^0.45.0",
    "@lexical/text": "^0.45.0",
    "@pond/icons": "workspace:*",
    "@pond/schema": "workspace:*",
    "@pond/theme": "workspace:*",
    "@pond/ui": "workspace:*",
    "@shadcn/react": "^0.2.1",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/store": "^0.11.0",
    "@visx/curve": "^4.0.0",
    "@visx/shape": "^4.0.0",
    "@web-kits/audio": "^0.1.0",
    "ai": "^7.0.4",
    "better-sqlite3": "^12.11.1",
    "calligraph": "^1.4.1",
    "chrono-node": "^2.9.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "ffmpeg-static": "^5.2.0",
    "fuse.js": "^7.4.2",
    "gpt-tokenizer": "^3.4.0",
    "hnswlib-wasm": "^0.8.2",
    "hono": "^4.12.18",
    "jsonrepair": "^3.14.1",
    "lexical": "^0.45.0",
    "metascraper": "^5.50.6",
    "metascraper-author": "^5.50.6",
    "metascraper-date": "^5.50.6",
    "metascraper-description": "^5.50.6",
    "metascraper-image": "^5.50.6",
    "metascraper-logo-favicon": "^5.50.6",
    "metascraper-publisher": "^5.50.6",
    "metascraper-title": "^5.50.6",
    "metascraper-url": "^5.50.6",
    "mime-types": "^3.0.2",
    "motion": "^12.39.0",
    "p-limit": "^7.3.0",
    "pretty-bytes": "^7.1.0",
    "pretty-ms": "^9.3.0",
    "rooks": "^9.8.0",
    "sharp": "^0.34.5",
    "ulid": "^3.0.2",
    "warcio": "^2.4.10",
    "which": "^7.0.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@tanstack/router-cli": "1.167.10",
    "@tanstack/router-plugin": "^1.168.11",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/which": "^3.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^42.4.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "replaywebpage": "^2.4.6",
    "typescript": "catalog:",
    "vite": "^8.0.11",
    "vitest": "^4.1.8"
  }
}
