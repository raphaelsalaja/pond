{
  "name": "@pond/desktop",
  "productName": "Pond",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Pond desktop app: local-first archive with a menu-bar tray, local SQLite index and filesystem library.",
  "license": "MIT",
  "author": {
    "name": "Raphael Salaja",
    "url": "https://github.com/raphaelsalaja"
  },
  "homepage": "https://github.com/raphaelsalaja/pond#readme",
  "bugs": {
    "url": "https://github.com/raphaelsalaja/pond/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphaelsalaja/pond.git",
    "directory": "apps/desktop"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/run-dev-singleton.mjs -- electron-vite dev --watch",
    "build": "node ./scripts/prepare-icon-previews.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "postinstall": "node ./scripts/postinstall.mjs",
    "rebuild": "node ./scripts/rebuild-native.mjs",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "dist": "node ./scripts/build-native-host.mjs && electron-builder --mac --arm64 --x64",
    "dist:mac": "node ./scripts/build-native-host.mjs && electron-builder --mac --arm64 --x64",
    "dist:mac:arm64": "node ./scripts/build-native-host.mjs && electron-builder --mac --arm64",
    "dist:mac:publish": "node ./scripts/build-native-host.mjs && electron-builder --mac --arm64 --x64 --publish always",
    "dist:win": "node ./scripts/build-native-host.mjs && electron-builder --win --x64 --config.npmRebuild=false --publish never",
    "dist:win:publish": "node ./scripts/build-native-host.mjs && electron-builder --win --x64 --config.npmRebuild=false --publish always",
    "dist:linux": "node -e \"console.error('Linux is coming soon.'); process.exit(1)\"",
    "db:generate": "ELECTRON_RUN_AS_NODE=1 pnpm exec electron ./node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "ELECTRON_RUN_AS_NODE=1 pnpm exec electron ./node_modules/drizzle-kit/bin.cjs push",
    "typecheck": "tsr generate && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "pnpm test:setup && vitest run",
    "test:setup": "node --test ./scripts/postinstall.test.mjs ./scripts/verify-binaries.test.mjs ./scripts/verify-binaries.test.cjs",
    "smoke:desktop": "electron ./scripts/smoke-desktop.cjs",
    "smoke:folder-tags": "electron ./scripts/smoke-folder-tags.cjs",
    "smoke:library-trust": "electron ./scripts/smoke-library-trust.cjs",
    "smoke:sensitive-content": "node ./scripts/smoke-sensitive-content.mjs",
    "smoke:offline-release": "node ./scripts/smoke-offline-release.mjs",
    "generate:harvest": "node scripts/generate-harvest-validation.mjs",
    "generate": "pnpm generate:harvest",
    "generate:check": "pnpm generate:harvest --check"
  },
  "dependencies": {
