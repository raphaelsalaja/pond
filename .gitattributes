# Normalize to LF on every platform: Biome and the shell hooks in .husky expect
# it, and Windows checkouts must not rewrite files to CRLF.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.heic binary
*.mp4 binary
*.wav binary
*.woff binary
*.woff2 binary
*.eaglepack binary
*.node binary
*.dll binary
*.icns binary
*.dmg binary
*.exe binary
*.AppImage binary
*.deb binary
*.zip binary
*.tar binary
*.tar.gz binary

pnpm-lock.yaml -diff linguist-generated=true
